{
  "name": "vecialaorden",
  "private": true,
  "description": "Veci a la Orden: conecta a vecinos que necesitan un arreglo con maestros cercanos.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm test -w apps/api",
    "migration:run": "npm run migration:run -w apps/api",
    "migration:revert": "npm run migration:revert -w apps/api",
    "migration:generate": "npm run migration:generate -w apps/api"
  }
}
