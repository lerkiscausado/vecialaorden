# Copia este archivo como .env y llena tus valores reales.
# El archivo .env nunca se sube a GitHub.

# --- Servidor ---
PORT=3001
# URL de la web, para permitir sus peticiones (CORS). Varias separadas por coma.
WEB_ORIGIN=http://localhost:3000

# --- Base de datos MySQL 8 ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=veci
DB_PASSWORD=cambia_esto
DB_NAME=vecialaorden
# Pon true solo si tu proveedor de MySQL exige conexión cifrada (TLS).
DB_SSL=false

# --- JWT (por ahora solo token de acceso) ---
# Genera uno largo y aleatorio, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# --- Cifrado de secretos guardados en la base (claves de API de IA) ---
# 64 caracteres hexadecimales. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ¡Guárdala bien! Si la pierdes o la cambias, hay que volver a escribir las claves de IA.
CONFIG_ENCRYPTION_KEY=

# --- Códigos de verificación por WhatsApp (OTP) ---
# Secreto para guardar los códigos cifrados (otro valor aleatorio, distinto al JWT).
OTP_SECRET=cambia_esto_tambien
OTP_TTL_MINUTES=10

# --- WhatsApp Cloud API (Meta) ---
# Si WHATSAPP_TOKEN está vacío, los códigos NO se envían: se muestran en la consola del API (modo desarrollo).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Nombre de la plantilla de autenticación aprobada en Meta para enviar el código.
WHATSAPP_OTP_TEMPLATE=codigo_verificacion
WHATSAPP_TEMPLATE_LANG=es

# --- Créditos ---
CREDITOS_BIENVENIDA=10
